{
  "name": "AllowedUser",
  "type": "object",
  "properties": {
    "email": {
      "type": "string",
      "description": "\u05d0\u05d9\u05de\u05d9\u05d9\u05dc \u05d4\u05de\u05e9\u05ea\u05de\u05e9 \u05d4\u05de\u05d5\u05e8\u05e9\u05d4"
    },
    "full_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05de\u05dc\u05d0"
    },
    "user_type": {
      "type": "string",
      "enum": [
        "client",
        "advisor",
        "admin"
      ],
      "default": "client",
      "description": "\u05ea\u05e4\u05e7\u05d9\u05d3 \u05d4\u05de\u05e9\u05ea\u05de\u05e9"
    },
    "phone": {
      "type": "string",
      "description": "\u05de\u05e1\u05e4\u05e8 \u05d8\u05dc\u05e4\u05d5\u05df"
    },
    "personal_code": {
      "type": "string",
      "description": "\u05e7\u05d5\u05d3 \u05d0\u05d9\u05e9\u05d9 (4 \u05d0\u05d5\u05ea\u05d9\u05d5\u05ea) \u05e9\u05e0\u05d5\u05e6\u05e8 \u05de\u05d9\u05d3 \u05e2\u05dd \u05d4\u05d4\u05e8\u05e9\u05de\u05d4 - \u05e0\u05e9\u05de\u05e8 \u05db\u05d0\u05df \u05e2\u05d3 \u05e9\u05d4\u05dc\u05e7\u05d5\u05d7 \u05e0\u05db\u05e0\u05e1 \u05dc\u05d0\u05e4\u05dc\u05d9\u05e7\u05e6\u05d9\u05d4 \u05dc\u05e8\u05d0\u05e9\u05d5\u05e0\u05d4, \u05d5\u05d0\u05d6 \u05de\u05d5\u05e2\u05ea\u05e7 \u05dc\u05e8\u05e9\u05d5\u05de\u05ea \u05d4\u05de\u05e9\u05ea\u05de\u05e9"
    }
  },
  "required": [
    "email",
    "user_type"
  ]
}