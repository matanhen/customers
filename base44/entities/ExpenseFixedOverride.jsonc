{
  "name": "ExpenseFixedOverride",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05de\u05e9\u05ea\u05de\u05e9 \u05e9\u05d0\u05dc\u05d9\u05d5 \u05e9\u05d9\u05d9\u05db\u05ea \u05d4\u05d1\u05d7\u05d9\u05e8\u05d4"
    },
    "item_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05e1\u05e2\u05d9\u05e3 \u05d4\u05d4\u05d5\u05e6\u05d0\u05d4 (\u05e1\u05e2\u05d9\u05e3 \u05e7\u05d9\u05d9\u05dd \u05d1\u05de\u05e2\u05e8\u05db\u05ea \u05d0\u05d5 \u05e1\u05e2\u05d9\u05e3 \u05e9\u05d4\u05d5\u05e1\u05e3 \u05d9\u05d3\u05e0\u05d9\u05ea)"
    },
    "is_fixed": {
      "type": "boolean",
      "default": true,
      "description": "\u05d4\u05d0\u05dd \u05d4\u05e1\u05e2\u05d9\u05e3 \u05de\u05d5\u05d2\u05d3\u05e8 \u05db\u05d4\u05d5\u05e6\u05d0\u05d4 \u05e7\u05d1\u05d5\u05e2\u05d4 \u05e2\u05d1\u05d5\u05e8 \u05d4\u05de\u05e9\u05ea\u05de\u05e9 (\u05e0\u05e9\u05de\u05e8 \u05e2\u05d3 \u05dc\u05e9\u05d9\u05e0\u05d5\u05d9)"
    }
  },
  "required": [
    "user_id",
    "item_name"
  ]
}