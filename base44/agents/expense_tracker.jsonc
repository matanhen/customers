  "model": "automatic",
  "whatsapp_greeting": "\u05e9\u05dc\u05d5\u05dd! \ud83d\udc4b \u05d0\u05e0\u05d9 \u05d4\u05d1\u05d5\u05d8 \u05e9\u05dc '\u05e6\u05e2\u05d9\u05e8\u05d9\u05dd \u05de\u05ea\u05e2\u05e9\u05e8\u05d9\u05dd'.\n\n\u05d0\u05e0\u05d9 \u05d9\u05db\u05d5\u05dc \u05dc\u05e2\u05d6\u05d5\u05e8 \u05dc\u05da \u05d1\u05e9\u05dc\u05d5\u05e9\u05d4 \u05d3\u05d1\u05e8\u05d9\u05dd:\n\n\ud83d\udcca \u05ea\u05d9\u05e2\u05d5\u05d3 \u05d4\u05d5\u05e6\u05d0\u05d5\u05ea - \u05e9\u05dc\u05d7 \u05d4\u05d5\u05d3\u05e2\u05d4 \u05db\u05de\u05d5 '\u05e7\u05e4\u05d4 18' \u05d0\u05d5 '\u05d3\u05dc\u05e7 200' \u05d5\u05d0\u05e2\u05d3\u05db\u05df \u05d0\u05ea \u05d4\u05de\u05e2\u05e7\u05d1 \u05d4\u05d7\u05d5\u05d3\u05e9\u05d9 \u05e9\u05dc\u05da. \u05d0\u05e4\u05e9\u05e8 \u05d2\u05dd \u05dc\u05e9\u05dc\u05d5\u05d7 \u05ea\u05de\u05d5\u05e0\u05ea \u05d7\u05e9\u05d1\u05d5\u05e0\u05d9\u05ea.\n\n\ud83d\udcc5 \u05e7\u05d1\u05d9\u05e2\u05ea \u05e4\u05d2\u05d9\u05e9\u05d5\u05ea - \u05e9\u05dc\u05d7 \u05d4\u05d5\u05d3\u05e2\u05d4 \u05db\u05de\u05d5 '\u05e0\u05e7\u05d1\u05e2\u05d4 \u05e4\u05d2\u05d9\u05e9\u05d4 \u05e2\u05dd \u05d4\u05dc\u05e7\u05d5\u05d7 \u05d0\u05d1\u05d9 054888858 \u05d1\u05ea\u05d0\u05e8\u05d9\u05da 22/09/2026 \u05d1\u05e9\u05e2\u05d4 18:00 \u05d1\u05de\u05e9\u05e8\u05d3' \u05d5\u05d0\u05e7\u05d1\u05e2 \u05d0\u05ea \u05d4\u05e4\u05d2\u05d9\u05e9\u05d4.\n\n\u2705 \u05e2\u05d3\u05db\u05d5\u05df \u05e1\u05d8\u05d8\u05d5\u05e1 \u05e4\u05d2\u05d9\u05e9\u05d4 - \u05e9\u05dc\u05d7 \u05d4\u05d5\u05d3\u05e2\u05d4 \u05db\u05de\u05d5 '\u05d4\u05e4\u05d2\u05d9\u05e9\u05d4 \u05e2\u05dd \u05d0\u05d1\u05d9 054777585 \u05e9\u05d4\u05d9\u05d9\u05ea\u05d4 \u05d4\u05d9\u05d5\u05dd \u05d4\u05ea\u05e7\u05d9\u05d9\u05de\u05d4' \u05d5\u05d0\u05e2\u05d3\u05db\u05df \u05d0\u05ea \u05d4\u05e1\u05d8\u05d8\u05d5\u05e1.\n\n\u05de\u05d4 \u05ea\u05e8\u05e6\u05d4 \u05dc\u05e2\u05e9\u05d5\u05ea?",
