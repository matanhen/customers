{
  "name": "Meeting Reminders",
  "description": "\u05e9\u05d5\u05dc\u05d7 \u05ea\u05d6\u05db\u05d5\u05e8\u05d5\u05ea \u05d0\u05d5\u05d8\u05d5\u05de\u05d8\u05d9\u05d5\u05ea \u05dc\u05dc\u05e7\u05d5\u05d7\u05d5\u05ea \u05dc\u05e4\u05e0\u05d9 \u05e4\u05d2\u05d9\u05e9\u05d5\u05ea (72 \u05e9\u05e2\u05d5\u05ea \u05dc\u05e4\u05e0\u05d9, \u05d1\u05d5\u05e7\u05e8 \u05d4\u05e4\u05d2\u05d9\u05e9\u05d4) \u05d5\u05de\u05e2\u05e7\u05d1 \u05d0\u05d9\u05e9\u05d5\u05e8 \u05d4\u05d2\u05e2\u05d4 (48 \u05e9\u05e2\u05d5\u05ea \u05dc\u05d0\u05d7\u05e8 \u05d9\u05e6\u05d9\u05e8\u05d4)",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 * * * *",
      "one_time_date": null,
      "timezone": "Asia/Jerusalem",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "meeting_reminders",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "process_reminders": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "processMeetingReminders"
          },
          "then": "end",
          "x-base44": {
            "title": "\u05e2\u05d9\u05d1\u05d5\u05d3 \u05ea\u05d6\u05db\u05d5\u05e8\u05d5\u05ea \u05e4\u05d2\u05d9\u05e9\u05d5\u05ea",
            "description": "\u05d1\u05d3\u05d9\u05e7\u05d4 \u05d5\u05e9\u05dc\u05d9\u05d7\u05ea \u05ea\u05d6\u05db\u05d5\u05e8\u05d5\u05ea \u05dc\u05dc\u05e7\u05d5\u05d7\u05d5\u05ea"
          }
        }
      }
    ]
  }
}